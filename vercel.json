{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.bacpilot.site" }],
      "destination": "https://bacpilot.site/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "mhmbac.vercel.app" }],
      "destination": "https://bacpilot.site/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.bacpilot.site" }],
      "destination": "https://bacpilot.site/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "mhmbac.vercel.app" }],
      "destination": "https://bacpilot.site/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|branding/|robots\\.txt|sitemap\\.xml|site\\.webmanifest|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "mhmbac.vercel.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
