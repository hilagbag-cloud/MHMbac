{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/a-propos",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.bacpilot.site" }],
      "destination": "https://bacpilot.site/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "mhmbac.vercel.app" }],
      "destination": "https://bacpilot.site/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.bacpilot.site" }],
      "destination": "https://bacpilot.site/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "mhmbac.vercel.app" }],
      "destination": "https://bacpilot.site/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap-contributeurs-beta.xml",
      "destination": "/api/contributor-sitemap"
    },
    {
      "source": "/contributeurs-beta",
      "destination": "/api/contributor-directory"
    },
    {
      "source": "/contributeurs-beta/:slug/photo",
      "destination": "https://uxdfrnogiuefoqjpobpf.supabase.co/functions/v1/public-beta-contributor-profile?slug=:slug&asset=photo"
    },
    {
      "source": "/contributeurs-beta/:slug",
      "destination": "/api/contributor-profile?slug=:slug"
    },
    {
      "source": "/((?!assets/|branding/|robots\\.txt|sitemap\\.xml|sitemap-contributeurs-beta\\.xml|site\\.webmanifest|favicon\\.ico|apple-touch-icon\\.png).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "mhmbac.vercel.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "beta.bacpilot.site" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/apple-touch-icon.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/branding/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
