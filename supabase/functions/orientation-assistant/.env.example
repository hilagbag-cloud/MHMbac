# À renseigner exclusivement dans Supabase > Edge Functions > Secrets.
# Ne pas copier ces valeurs dans Vercel, VITE_*, GitHub ou l’extension Chrome.

# Fournisseur principal facultatif. Sans cette clé, BacPilot reste pleinement
# fonctionnel avec ses réponses et scores déterministes.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Fournisseur de secours facultatif. Utilisé une fois seulement si Gemini échoue.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
